                    </mxGeometry>
                </mxCell>
                <mxCell id="lane-inpage" value="&lt;font style=&#39;font-size: 18px&#39;&gt;inpage.js — MAIN world&lt;/font&gt;&lt;br&gt;runs in the dApp&#39;s own context" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="init" vertex="1">
                    <mxGeometry x="1290" y="258" width="380" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="tab loads" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="init" vertex="1">
                    <mxGeometry x="520" y="45" width="80" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="&lt;b&gt;service worker registers the inpage script&lt;/b&gt;&lt;br&gt;&lt;font face=&#39;monospace&#39;&gt;inpage/js/inpage.js&lt;/font&gt; — MAIN world, &lt;font face=&#39;monospace&#39;&gt;document_start&lt;/font&gt;, all frames&lt;br&gt;&lt;i&gt;MAIN world injection cannot be declared in the manifest&lt;/i&gt;" style="whiteSpace=wrap;html=1;" parent="init" vertex="1">
                    <mxGeometry x="370" y="155" width="380" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n2b" value="the content script (ISOLATED world) opens the Port that inpage.js uses to reach the service worker" style="whiteSpace=wrap;html=1;dashed=1;" parent="init" vertex="1">
                    <mxGeometry x="830" y="165" width="400" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="&lt;b&gt;initializeProvider(connection)&lt;/b&gt;" style="whiteSpace=wrap;html=1;rounded=1;" parent="init" vertex="1">
                    <mxGeometry x="430" y="300" width="260" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="&lt;b&gt;chain-agnostic provider&lt;/b&gt;&lt;br&gt;&lt;font face=&#39;monospace&#39;&gt;new Proxy(new ChainAgnosticProvider(connection), { deleteProperty: () =&gt; true })&lt;/font&gt;" style="whiteSpace=wrap;html=1;" parent="init" vertex="1">
                    <mxGeometry x="370" y="380" width="380" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="&lt;b&gt;EVM provider&lt;/b&gt;&lt;br&gt;&lt;font face=&#39;monospace&#39;&gt;new Proxy(new EVMProvider({ maxListeners, walletVersion, info: { name, uuid, icon, description, rdns } }), { deleteProperty: () =&gt; true })&lt;/font&gt;&lt;br&gt;&lt;i&gt;deleteProperty is swallowed because libraries like web3@1.x delete properties off the provider&lt;/i&gt;" style="whiteSpace=wrap;html=1;" parent="init" vertex="1">
                    <mxGeometry x="370" y="490" width="380" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="n6" value="&lt;b&gt;multi-wallet proxy&lt;/b&gt;&lt;br&gt;&lt;font face=&#39;monospace&#39;&gt;createMultiWalletProxy(evmProvider)&lt;/font&gt;&lt;br&gt;providers = [ Core ], Core is the default&lt;br&gt;unknown reads fall through to the default provider, writes are parked on a separate extensions object" style="whiteSpace=wrap;html=1;" parent="init" vertex="1">
                    <mxGeometry x="370" y="640" width="380" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="n7" value="&lt;b&gt;collect other wallets&lt;/b&gt;&lt;br&gt;on &lt;font face=&#39;monospace&#39;&gt;eip6963:announceProvider&lt;/font&gt; read only &lt;font face=&#39;monospace&#39;&gt;uuid&lt;/font&gt;, &lt;font face=&#39;monospace&#39;&gt;name&lt;/font&gt;, &lt;font face=&#39;monospace&#39;&gt;icon&lt;/font&gt;, &lt;font face=&#39;monospace&#39;&gt;rdns&lt;/font&gt; behind a type guard, then &lt;font face=&#39;monospace&#39;&gt;addProvider()&lt;/font&gt;&lt;br&gt;&lt;i&gt;never spread or enumerate a foreign provider — a recursive Proxy can stall the renderer&lt;/i&gt;" style="whiteSpace=wrap;html=1;" parent="init" vertex="1">
                    <mxGeometry x="830" y="640" width="400" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="n8" value="&lt;b&gt;setGlobalProvider&lt;/b&gt;&lt;br&gt;&lt;font face=&#39;monospace&#39;&gt;Object.defineProperty(window, &#39;ethereum&#39;, {&lt;br&gt;&amp;nbsp; get: () =&gt; multiWalletProxy,&lt;br&gt;&amp;nbsp; set: () =&gt; multiWalletProxy,&lt;br&gt;});&lt;/font&gt;&lt;br&gt;&lt;i&gt;the setter swallows other wallets&#39; overwrite attempts&lt;/i&gt;" style="whiteSpace=wrap;html=1;" parent="init" vertex="1">
                    <mxGeometry x="370" y="800" width="380" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="n9" value="did defineProperty succeed?&lt;br&gt;&lt;i&gt;it throws if another extension was faster and defined window.ethereum as non-configurable&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;" parent="init" vertex="1">
                    <mxGeometry x="380" y="970" width="360" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="n10" value="&lt;font face=&#39;monospace&#39;&gt;window.web3&lt;/font&gt; defined as a getter/setter pair with &lt;font face=&#39;monospace&#39;&gt;currentProvider = multiWalletProxy&lt;/font&gt;&lt;br&gt;dApp extensions are merged, MetaMask shim assignments are ignored&lt;br&gt;dispatch &lt;font face=&#39;monospace&#39;&gt;ethereum#initialized&lt;/font&gt;" style="whiteSpace=wrap;html=1;" parent="init" vertex="1">
                    <mxGeometry x="370" y="1140" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n11" value="log the failure, then fall back to&lt;br&gt;&lt;font face=&#39;monospace&#39;&gt;window.ethereum = evmProvider&lt;/font&gt;&lt;br&gt;&lt;i&gt;only lands if the existing value is a cooperative proxy like ours&lt;/i&gt;" style="whiteSpace=wrap;html=1;" parent="init" vertex="1">
                    <mxGeometry x="830" y="965" width="400" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n12" value="did it land?" style="rhombus;whiteSpace=wrap;html=1;" parent="init" vertex="1">
                    <mxGeometry x="930" y="1130" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n13" value="Core is not reachable through &lt;font face=&#39;monospace&#39;&gt;window.ethereum&lt;/font&gt;&lt;br&gt;the failure is logged; dApps can still reach Core via EIP-6963 or &lt;font face=&#39;monospace&#39;&gt;window.avalanche&lt;/font&gt;" style="whiteSpace=wrap;html=1;" parent="init" vertex="1">
                    <mxGeometry x="1280" y="1120" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n14" value="&lt;b&gt;setAvalancheGlobalProvider&lt;/b&gt;&lt;br&gt;&lt;font face=&#39;monospace&#39;&gt;Object.defineProperty(window, &#39;avalanche&#39;, { value: evmProvider, writable: false });&lt;/font&gt;&lt;br&gt;dispatch &lt;font face=&#39;monospace&#39;&gt;avalanche#initialized&lt;/font&gt;" style="whiteSpace=wrap;html=1;" parent="init" vertex="1">
                    <mxGeometry x="370" y="1290" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n15" value="&lt;b&gt;announceWalletProvider&lt;/b&gt;&lt;br&gt;dispatch &lt;font face=&#39;monospace&#39;&gt;eip6963:announceProvider&lt;/font&gt; with a frozen &lt;font face=&#39;monospace&#39;&gt;{ info, provider }&lt;/font&gt;, and re-dispatch it on every &lt;font face=&#39;monospace&#39;&gt;eip6963:requestProvider&lt;/font&gt;" style="whiteSpace=wrap;html=1;" parent="init" vertex="1">
                    <mxGeometry x="60" y="1430" width="360" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n16" value="&lt;b&gt;announceChainAgnosticProvider&lt;/b&gt;&lt;br&gt;dispatch &lt;font face=&#39;monospace&#39;&gt;core-wallet:announceProvider&lt;/font&gt;, and re-dispatch it on every &lt;font face=&#39;monospace&#39;&gt;core-wallet:requestProvider&lt;/font&gt;" style="whiteSpace=wrap;html=1;" parent="init" vertex="1">
                    <mxGeometry x="470" y="1430" width="360" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="n17" value="&lt;b&gt;Wallet Standard registration&lt;/b&gt;&lt;br&gt;&lt;font face=&#39;monospace&#39;&gt;initializeSolanaProvider(new SolanaWalletProvider(chainAgnosticProvider, ...))&lt;/font&gt;&lt;br&gt;&lt;i&gt;wrapped in try/catch, failures are ignored&lt;/i&gt;" style="whiteSpace=wrap;html=1;" parent="init" vertex="1">
